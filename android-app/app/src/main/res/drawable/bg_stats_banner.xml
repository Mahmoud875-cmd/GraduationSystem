<?xml version="1.0" encoding="utf-8"?>
<!-- Modern reports stats banner: indigo diagonal gradient, 16dp radius. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <gradient
        android:angle="315"
        android:startColor="@color/indigo_700"
        android:centerColor="@color/indigo_600"
        android:endColor="@color/indigo_800"
        android:type="linear" />
    <corners android:radius="16dp" />
</shape>
