<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/gutter"
        android:paddingVertical="@dimen/space_lg">

        <!-- Toolbar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/btnBack"
                android:layout_width="@dimen/min_touch"
                android:layout_height="@dimen/min_touch"
                android:contentDescription="@string/back"
                android:padding="12dp"
                android:src="@drawable/ic_arrow_forward"
                app:tint="@color/on_surface_variant" />

            <TextView
                style="@style/Text.HeadlineSm"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_xs"
                android:layout_weight="1"
                android:text="@string/evaluation_title" />

            <FrameLayout
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="@drawable/bg_circle_primary">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_gravity="center"
                    android:contentDescription="@string/prof_panel_title"
                    android:src="@drawable/ic_person"
                    app:tint="@color/on_primary" />
            </FrameLayout>
        </LinearLayout>

        <!-- Context header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_lg"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    style="@style/Text.LabelLg"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/eval_category_label"
                    android:textColor="@color/primary" />

                <TextView
                    android:id="@+id/defenseBadge"
                    style="@style/Text.LabelSm"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_suggestion_chip"
                    android:paddingHorizontal="@dimen/space_sm"
                    android:paddingVertical="4dp"
                    android:text="@string/eval_defense_badge"
                    android:textColor="@color/on_secondary_container"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/projectTitle"
                style="@style/Text.HeadlineMd"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs" />

            <TextView
                android:id="@+id/studentInfo"
                style="@style/Text.BodyMd"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs"
                android:textColor="@color/on_surface_variant" />
        </LinearLayout>

        <!-- Already-evaluated banner -->
        <TextView
            android:id="@+id/alreadyBanner"
            style="@style/ChipText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_md"
            android:background="@drawable/chip_approved"
            android:gravity="center"
            android:padding="@dimen/space_sm"
            android:text="@string/already_evaluated"
            android:textColor="@color/status_approved_fg"
            android:visibility="gone" />

        <!-- Progress card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_lg"
            android:background="@drawable/bg_eval_card"
            android:elevation="1dp"
            android:orientation="vertical"
            android:padding="@dimen/space_md">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <FrameLayout
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginEnd="@dimen/space_sm"
                    android:background="@drawable/bg_circle_primary_container">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_gravity="center"
                        android:contentDescription="@string/eval_progress_title"
                        android:src="@drawable/ic_folder"
                        app:tint="@color/on_primary" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/Text.LabelLg"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/eval_progress_title"
                        android:textColor="@color/on_surface"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/groupName"
                        style="@style/Text.BodySm"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/on_surface_variant" />
                </LinearLayout>
            </LinearLayout>

            <!-- Progress steps (decorative) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_md"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="3dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="6dp"
                        android:background="@drawable/bg_step_bar" />

                    <TextView
                        style="@style/Text.LabelSm"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/eval_step_topic"
                        android:textColor="@color/on_surface" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="3dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="6dp"
                        android:background="@drawable/bg_step_bar" />

                    <TextView
                        style="@style/Text.LabelSm"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/eval_step_draft"
                        android:textColor="@color/on_surface" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="3dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="6dp"
                        android:background="@drawable/bg_step_bar" />

                    <TextView
                        style="@style/Text.LabelSm"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/eval_step_impl"
                        android:textColor="@color/on_surface" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="3dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="6dp"
                        android:background="@drawable/bg_step_bar" />

                    <TextView
                        style="@style/Text.LabelSm"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/eval_step_defense"
                        android:textColor="@color/on_surface" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- Evaluation form card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_lg"
            android:background="@drawable/bg_eval_card"
            android:elevation="1dp"
            android:orientation="vertical"
            android:padding="@dimen/space_md">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginEnd="@dimen/space_sm"
                    android:contentDescription="@string/eval_form_title"
                    android:src="@drawable/ic_grade"
                    app:tint="@color/primary" />

                <TextView
                    style="@style/Text.HeadlineSm"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/eval_form_title" />
            </LinearLayout>

            <!-- Grade input -->
            <TextView
                style="@style/Text.LabelLg"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_lg"
                android:layout_marginBottom="@dimen/space_xs"
                android:text="@string/eval_grade_label"
                android:textColor="@color/on_surface" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <EditText
                    android:id="@+id/inputScore"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_eval_input"
                    android:fontFamily="@font/vazirmatn_regular"
                    android:gravity="start|center_vertical"
                    android:hint="@string/eval_grade_hint"
                    android:importantForAutofill="no"
                    android:inputType="numberDecimal"
                    android:minHeight="@dimen/min_touch"
                    android:paddingHorizontal="@dimen/space_md"
                    android:textColor="@color/on_surface"
                    android:textColorHint="@color/outline"
                    android:textSize="@dimen/text_body_lg" />

                <TextView
                    style="@style/Text.BodyMd"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical|end"
                    android:layout_marginEnd="@dimen/space_md"
                    android:text="@string/eval_grade_suffix"
                    android:textColor="@color/on_surface_variant" />
            </FrameLayout>

            <TextView
                style="@style/Text.BodySm"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs"
                android:text="@string/eval_grade_note"
                android:textColor="@color/on_surface_variant" />

            <!-- Feedback textarea -->
            <TextView
                style="@style/Text.LabelLg"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_lg"
                android:layout_marginBottom="@dimen/space_xs"
                android:text="@string/eval_feedback_label"
                android:textColor="@color/on_surface" />

            <EditText
                android:id="@+id/inputComments"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_eval_input"
                android:fontFamily="@font/vazirmatn_regular"
                android:gravity="top|start"
                android:hint="@string/eval_feedback_hint"
                android:importantForAutofill="no"
                android:inputType="textMultiLine"
                android:minHeight="140dp"
                android:padding="@dimen/space_md"
                android:textColor="@color/on_surface"
                android:textColorHint="@color/outline"
                android:textSize="@dimen/text_body_md" />

            <!-- Quick suggestion chips -->
            <TextView
                style="@style/Text.LabelMd"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_md"
                android:layout_marginBottom="@dimen/space_xs"
                android:text="@string/eval_suggestions_label"
                android:textColor="@color/on_surface_variant" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/suggestionChips"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:chipSpacingVertical="4dp">

                <TextView
                    android:id="@+id/chipQuality"
                    style="@style/Text.LabelMd"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_suggestion_chip"
                    android:clickable="true"
                    android:focusable="true"
                    android:paddingHorizontal="@dimen/space_md"
                    android:paddingVertical="8dp"
                    android:text="@string/eval_tag_quality"
                    android:textColor="@color/on_secondary_container" />

                <TextView
                    android:id="@+id/chipDefense"
                    style="@style/Text.LabelMd"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_suggestion_chip"
                    android:clickable="true"
                    android:focusable="true"
                    android:paddingHorizontal="@dimen/space_md"
                    android:paddingVertical="8dp"
                    android:text="@string/eval_tag_defense"
                    android:textColor="@color/on_secondary_container" />

                <TextView
                    android:id="@+id/chipDocs"
                    style="@style/Text.LabelMd"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_suggestion_chip"
                    android:clickable="true"
                    android:focusable="true"
                    android:paddingHorizontal="@dimen/space_md"
                    android:paddingVertical="8dp"
                    android:text="@string/eval_tag_docs"
                    android:textColor="@color/on_secondary_container" />
            </com.google.android.material.chip.ChipGroup>
        </LinearLayout>

        <!-- Save button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSubmit"
            style="@style/Widget.App.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_lg"
            android:text="@string/eval_save_btn"
            app:icon="@drawable/ic_save"
            app:iconGravity="textStart" />
    </LinearLayout>
</ScrollView>
