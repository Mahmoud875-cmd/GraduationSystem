<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <!-- ============ Stitch header: checklist circle + title/subtitle + filters button ============ -->
    <LinearLayout
        android:id="@+id/headerSection"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/space_lg"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <FrameLayout
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginEnd="@dimen/space_sm"
            android:background="@drawable/bg_circle_secondary_container">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:contentDescription="@string/project_tasks_title"
                android:src="@drawable/ic_checklist"
                app:tint="@color/on_secondary_container" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                style="@style/Text.HeadlineMd"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/project_tasks_title" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/vazirmatn_regular"
                android:text="@string/tasks_subtitle"
                android:textColor="@color/on_surface_variant"
                android:textSize="@dimen/text_body_sm" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/btnFilters"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_button_primary_container"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="@dimen/space_md"
            android:paddingVertical="@dimen/space_sm">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_marginEnd="@dimen/space_xs"
                android:contentDescription="@string/filters"
                android:src="@drawable/ic_filter_list"
                app:tint="@color/on_primary_container" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/vazirmatn_medium"
                android:text="@string/filters"
                android:textColor="@color/on_primary_container"
                android:textSize="@dimen/text_label_md" />
        </LinearLayout>
    </LinearLayout>

    <!-- ============ Stitch overall progress card ============ -->
    <LinearLayout
        android:id="@+id/progressCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/space_md"
        android:background="@drawable/bg_progress_card"
        android:elevation="1dp"
        android:orientation="vertical"
        android:padding="@dimen/space_md">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/vazirmatn_medium"
                android:text="@string/overall_progress_pct"
                android:textColor="@color/on_surface"
                android:textSize="@dimen/text_label_lg" />

            <TextView
                android:id="@+id/progressPercent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/vazirmatn_bold"
                android:textColor="@color/primary"
                android:textSize="@dimen/text_label_lg"
                tools:text="۵۰٪" />
        </LinearLayout>

        <ProgressBar
            android:id="@+id/overallProgressBar"
            style="@android:style/Widget.ProgressBar.Horizontal"
            android:layout_width="match_parent"
            android:layout_height="12dp"
            android:layout_marginTop="@dimen/space_sm"
            android:max="100"
            android:progressDrawable="@drawable/progress_fill_thick"
            tools:progress="50" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_sm"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/progressCounter"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/vazirmatn_regular"
                android:textColor="@color/on_surface_variant"
                android:textSize="@dimen/text_body_sm"
                tools:text="۳ وظیفه از ۶ وظیفه تکمیل شده" />

            <TextView
                android:id="@+id/btnViewReport"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/vazirmatn_medium"
                android:text="@string/view_full_report"
                android:textColor="@color/primary"
                android:textSize="@dimen/text_body_sm" />
        </LinearLayout>
    </LinearLayout>

    <!-- ============ Task card (Stitch) ============ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/space_md"
        android:background="@drawable/bg_task_card"
        android:elevation="2dp"
        android:orientation="vertical"
        android:padding="@dimen/space_md">

        <!-- Title row: phase pill + title | status chip with dot -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/taskPhase"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/chip_phase_primary"
                    android:fontFamily="@font/vazirmatn_medium"
                    android:paddingHorizontal="@dimen/space_sm"
                    android:paddingVertical="2dp"
                    android:textColor="@color/primary"
                    android:textSize="@dimen/text_label_sm"
                    tools:text="فاز اول - معماری" />

                <TextView
                    android:id="@+id/taskTitle"
                    style="@style/Text.HeadlineSm"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_xs"
                    android:fontFamily="@font/vazirmatn_bold"
                    android:text="-" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/statusChipRow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_sm"
                android:background="@drawable/chip_task_status"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="@dimen/space_md"
                android:paddingVertical="4dp">

                <TextView
                    android:id="@+id/taskStatusChip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/space_xs"
                    android:fontFamily="@font/vazirmatn_medium"
                    android:textColor="@color/on_surface"
                    android:textSize="@dimen/text_label_sm"
                    tools:text="در حال انجام" />

                <View
                    android:id="@+id/statusDot"
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:background="@drawable/dot_status" />
            </LinearLayout>
        </LinearLayout>

        <!-- Description -->
        <TextView
            android:id="@+id/taskDescription"
            style="@style/Text.BodyMuted"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_md" />

        <!-- Assignee avatar+name | deadline, over a hairline top border -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_md"
            android:background="@drawable/divider_top_surface_container"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingTop="@dimen/space_sm">

            <TextView
                android:id="@+id/assigneeAvatar"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_marginEnd="@dimen/space_sm"
                android:background="@drawable/bg_circle_secondary_fixed_dim"
                android:fontFamily="@font/vazirmatn_bold"
                android:gravity="center"
                android:textColor="@color/on_secondary_fixed"
                android:textSize="@dimen/text_label_sm"
                tools:text="ع‌م" />

            <TextView
                android:id="@+id/taskAssignee"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:fontFamily="@font/vazirmatn_medium"
                android:maxLines="1"
                android:textColor="@color/on_surface"
                android:textSize="@dimen/text_body_sm"
                tools:text="محول شده به: علی محمد" />

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginEnd="@dimen/space_xs"
                android:contentDescription="@string/label_deadline"
                android:src="@drawable/ic_calendar_today"
                app:tint="@color/on_surface_variant" />

            <TextView
                android:id="@+id/taskDeadline"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/vazirmatn_regular"
                android:textColor="@color/on_surface_variant"
                android:textSize="@dimen/text_body_sm"
                tools:text="مهلت: ۱۴۲/۰۹/۲۵" />
        </LinearLayout>

        <!-- Status change row: update icon + label | current status + chevron -->
        <LinearLayout
            android:id="@+id/statusSelectRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_sm"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginEnd="@dimen/space_xs"
                android:contentDescription="@string/status_update"
                android:src="@drawable/ic_update"
                app:tint="@color/on_surface_variant" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/vazirmatn_regular"
                android:text="@string/change_status_label"
                android:textColor="@color/on_surface_variant"
                android:textSize="@dimen/text_body_sm" />

            <TextView
                android:id="@+id/btnChangeStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_select_pill"
                android:clickable="true"
                android:drawableStart="@drawable/ic_expand_more"
                android:drawablePadding="2dp"
                android:focusable="true"
                android:fontFamily="@font/vazirmatn_medium"
                android:minHeight="32dp"
                android:paddingHorizontal="@dimen/space_sm"
                android:textColor="@color/on_surface"
                android:textSize="@dimen/text_body_sm"
                tools:text="در حال انجام" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
