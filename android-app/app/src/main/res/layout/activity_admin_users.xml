<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface"
    android:orientation="vertical">

    <!-- Header bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/gutter"
        android:paddingVertical="@dimen/space_sm">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="@dimen/min_touch"
            android:layout_height="@dimen/min_touch"
            android:contentDescription="@string/back"
            android:padding="12dp"
            android:src="@drawable/ic_arrow_forward"
            app:tint="@color/on_surface_variant" />

        <TextView
            style="@style/Text.HeadlineSm"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_xs"
            android:layout_weight="1"
            android:text="@string/admin_dashboard_title"
            android:textColor="@color/primary" />

        <ImageView
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:contentDescription="@string/admin_dashboard_title"
            android:src="@drawable/ic_shield_person"
            app:tint="@color/primary" />
    </LinearLayout>

    <!-- Title + Add button -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_sm"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/gutter">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                style="@style/Text.HeadlineMd"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/manage_users" />

            <TextView
                style="@style/Text.BodySm"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/admin_users_page_subtitle"
                android:textColor="@color/on_surface_variant" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAddUser"
            style="@style/Widget.App.Button.Primary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/add_user_btn"
            app:icon="@drawable/ic_add"
            app:iconGravity="textStart" />
    </LinearLayout>

    <!-- Search box -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/gutter"
        android:layout_marginTop="@dimen/space_md"
        android:background="@drawable/bg_input"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/space_md">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginEnd="@dimen/space_sm"
            android:contentDescription="@string/search_users_hint"
            android:src="@drawable/ic_search"
            app:tint="@color/on_surface_variant" />

        <EditText
            android:id="@+id/inputSearch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@null"
            android:fontFamily="@font/vazirmatn_regular"
            android:hint="@string/search_users_hint"
            android:importantForAutofill="no"
            android:inputType="text"
            android:minHeight="@dimen/min_touch"
            android:textColor="@color/on_surface"
            android:textColorHint="@color/on_surface_variant"
            android:textSize="@dimen/text_body_md" />
    </LinearLayout>

    <!-- Filter chips -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_md"
        android:paddingHorizontal="@dimen/gutter"
        android:clipToPadding="false"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/chipAll"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/space_sm"
                android:background="@drawable/bg_filter_chip_sel"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="@dimen/space_md"
                android:paddingVertical="@dimen/space_xs">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginEnd="6dp"
                    android:contentDescription="@string/filter_all"
                    android:src="@drawable/ic_group"
                    app:tint="@color/on_primary_container" />

                <TextView
                    android:id="@+id/chipAllLabel"
                    style="@style/Text.LabelMd"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/filter_all"
                    android:textColor="@color/on_primary_container" />

                <TextView
                    android:id="@+id/chipAllCount"
                    style="@style/Text.LabelSm"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_chip_count_sel"
                    android:paddingHorizontal="6dp"
                    android:textColor="@color/on_primary_container" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/chipStudents"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/space_sm"
                android:background="@drawable/bg_filter_chip_unsel"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="@dimen/space_md"
                android:paddingVertical="@dimen/space_xs">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginEnd="6dp"
                    android:contentDescription="@string/filter_students"
                    android:src="@drawable/ic_school"
                    app:tint="@color/on_surface_variant" />

                <TextView
                    android:id="@+id/chipStudentsLabel"
                    style="@style/Text.LabelMd"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/filter_students"
                    android:textColor="@color/on_surface_variant" />

                <TextView
                    android:id="@+id/chipStudentsCount"
                    style="@style/Text.LabelSm"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_chip_count_unsel"
                    android:paddingHorizontal="6dp"
                    android:textColor="@color/on_surface_variant" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/chipAdvisors"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/space_sm"
                android:background="@drawable/bg_filter_chip_unsel"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="@dimen/space_md"
                android:paddingVertical="@dimen/space_xs">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginEnd="6dp"
                    android:contentDescription="@string/filter_advisors"
                    android:src="@drawable/ic_psychology"
                    app:tint="@color/on_surface_variant" />

                <TextView
                    android:id="@+id/chipAdvisorsLabel"
                    style="@style/Text.LabelMd"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/filter_advisors"
                    android:textColor="@color/on_surface_variant" />

                <TextView
                    android:id="@+id/chipAdvisorsCount"
                    style="@style/Text.LabelSm"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_chip_count_unsel"
                    android:paddingHorizontal="6dp"
                    android:textColor="@color/on_surface_variant" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/chipAdmins"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_filter_chip_unsel"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="@dimen/space_md"
                android:paddingVertical="@dimen/space_xs">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginEnd="6dp"
                    android:contentDescription="@string/filter_admins"
                    android:src="@drawable/ic_shield_person"
                    app:tint="@color/on_surface_variant" />

                <TextView
                    android:id="@+id/chipAdminsLabel"
                    style="@style/Text.LabelMd"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/filter_admins"
                    android:textColor="@color/on_surface_variant" />

                <TextView
                    android:id="@+id/chipAdminsCount"
                    style="@style/Text.LabelSm"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_chip_count_unsel"
                    android:paddingHorizontal="6dp"
                    android:textColor="@color/on_surface_variant" />
            </LinearLayout>
        </LinearLayout>
    </HorizontalScrollView>

    <!-- List -->
    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipeRefresh"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/space_md"
        android:layout_weight="1">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recycler"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingHorizontal="@dimen/gutter"
                android:paddingBottom="@dimen/space_xl" />

            <ProgressBar
                android:id="@+id/loading"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:visibility="gone" />
        </FrameLayout>
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
</LinearLayout>
