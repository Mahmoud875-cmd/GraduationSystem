<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/gutter"
        android:paddingVertical="@dimen/space_xl">

        <FrameLayout
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="@dimen/space_md"
            android:background="@drawable/bg_circle_primary_container">

            <ImageView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="center"
                android:contentDescription="@string/app_name"
                android:src="@drawable/ic_school" />
        </FrameLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/vazirmatn_bold"
            android:gravity="center"
            android:text="@string/app_name"
            android:textColor="@color/on_surface"
            android:textSize="@dimen/text_headline_md" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/space_lg"
            android:fontFamily="@font/vazirmatn_regular"
            android:gravity="center"
            android:text="@string/register_subtitle"
            android:textColor="@color/outline"
            android:textSize="@dimen/text_body_md" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card"
            android:elevation="3dp"
            android:orientation="vertical"
            android:padding="@dimen/space_lg">

            <TextView
                style="@style/Text.HeadlineSm"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/register_title" />

            <!-- Full name -->
            <TextView style="@style/Text.LabelMd" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_md" android:layout_marginBottom="@dimen/space_xs" android:text="@string/label_fullname" />
            <EditText
                android:id="@+id/inputName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/space_md"
                android:background="@drawable/bg_input"
                android:fontFamily="@font/vazirmatn_regular"
                android:hint="@string/hint_fullname"
                android:inputType="textPersonName"
                android:minHeight="@dimen/min_touch"
                android:padding="@dimen/space_md"
                android:textColor="@color/on_surface"
                android:textColorHint="@color/outline"
                android:textSize="@dimen/text_body_md" />

            <!-- Email -->
            <TextView style="@style/Text.LabelMd" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginBottom="@dimen/space_xs" android:text="@string/label_email" />
            <EditText
                android:id="@+id/inputEmail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/space_md"
                android:background="@drawable/bg_input"
                android:fontFamily="@font/vazirmatn_regular"
                android:gravity="start|center_vertical"
                android:textDirection="ltr"
                android:hint="@string/hint_email"
                android:inputType="textEmailAddress"
                android:minHeight="@dimen/min_touch"
                android:padding="@dimen/space_md"
                android:textColor="@color/on_surface"
                android:textColorHint="@color/outline"
                android:textSize="@dimen/text_body_md" />

            <!-- Account type -->
            <TextView style="@style/Text.LabelMd" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginBottom="@dimen/space_xs" android:text="@string/label_account_type" />
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/roleDropdownLayout"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/space_md"
                android:hint="@string/choose_option">

                <AutoCompleteTextView
                    android:id="@+id/dropdownRole"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:editable="false"
                    android:focusable="true"
                    android:fontFamily="@font/vazirmatn_regular"
                    android:inputType="none"
                    android:textColor="@color/on_surface"
                    android:textSize="@dimen/text_body_md" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Password -->
            <TextView style="@style/Text.LabelMd" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginBottom="@dimen/space_xs" android:text="@string/label_password" />
            <EditText
                android:id="@+id/inputPassword"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/space_md"
                android:background="@drawable/bg_input"
                android:fontFamily="@font/vazirmatn_regular"
                android:textDirection="ltr"
                android:hint="\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u2022"
                android:inputType="textPassword"
                android:minHeight="@dimen/min_touch"
                android:padding="@dimen/space_md"
                android:textColor="@color/on_surface"
                android:textColorHint="@color/outline"
                android:textSize="@dimen/text_body_md" />

            <!-- Confirm password -->
            <TextView style="@style/Text.LabelMd" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginBottom="@dimen/space_xs" android:text="@string/label_confirm_password" />
            <EditText
                android:id="@+id/inputConfirm"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_input"
                android:fontFamily="@font/vazirmatn_regular"
                android:hint="\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u2022"
                android:inputType="textPassword"
                android:minHeight="@dimen/min_touch"
                android:padding="@dimen/space_md"
                android:textColor="@color/on_surface"
                android:textColorHint="@color/outline"
                android:textSize="@dimen/text_body_md" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRegister"
                style="@style/Widget.App.Button.Primary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_lg"
                android:text="@string/register_link"
                app:icon="@drawable/ic_arrow_forward"
                app:iconGravity="textEnd" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="@dimen/space_lg"
            android:orientation="horizontal">

            <TextView style="@style/Text.BodyMuted" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/have_account" />

            <TextView
                android:id="@+id/goLogin"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_xs"
                android:fontFamily="@font/vazirmatn_medium"
                android:text="@string/login_action"
                android:textColor="@color/primary"
                android:textSize="@dimen/text_label_lg" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
