<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/gutter"
        android:paddingTop="@dimen/space_lg"
        android:paddingBottom="@dimen/space_xl">

        <!-- Top bar: back + title (start) ... task_alt circle (end) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/space_lg"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <FrameLayout
                android:id="@+id/btnBack"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_icon_btn_surface">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:contentDescription="@string/back"
                    android:src="@drawable/ic_arrow_forward"
                    app:tint="@color/on_surface" />
            </FrameLayout>

            <TextView
                style="@style/Text.HeadlineSm"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_sm"
                android:layout_weight="1"
                android:text="@string/add_task_new_title" />

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_circle_secondary_container"
                android:contentDescription="@string/add_task"
                android:padding="9dp"
                android:src="@drawable/ic_task_alt"
                app:tint="@color/on_secondary_container" />
        </LinearLayout>

        <!-- Info banner: auto-notify student -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/space_lg"
            android:background="@drawable/bg_info_banner"
            android:baselineAligned="false"
            android:orientation="horizontal"
            android:padding="@dimen/space_md">

            <ImageView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginTop="2dp"
                android:layout_marginEnd="@dimen/space_md"
                android:background="@drawable/bg_circle_secondary_container"
                android:contentDescription="@string/notify_student_title"
                android:padding="6dp"
                android:src="@drawable/ic_info"
                app:tint="@color/primary" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    style="@style/Text.BodyMd"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/vazirmatn_bold"
                    android:text="@string/notify_student_title"
                    android:textColor="@color/on_secondary_fixed"
                    android:textStyle="bold" />

                <TextView
                    style="@style/Text.BodySm"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_xs"
                    android:lineSpacingMultiplier="1.2"
                    android:text="@string/notify_student_body"
                    android:textColor="@color/on_secondary_container" />
            </LinearLayout>
        </LinearLayout>

        <!-- Form card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card"
            android:elevation="2dp"
            android:orientation="vertical"
            android:padding="@dimen/space_lg">

            <!-- Field 1: Title -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/space_xs"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/Text.LabelLg"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/vazirmatn_bold"
                        android:text="@string/label_task_title"
                        android:textColor="@color/on_surface"
                        android:textStyle="bold" />

                    <TextView
                        style="@style/Text.LabelLg"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:text="@string/required"
                        android:textColor="@color/error" />
                </LinearLayout>

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/space_lg">

                    <EditText
                        android:id="@+id/inputTitle"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:background="@drawable/bg_input"
                        android:fontFamily="@font/vazirmatn_regular"
                        android:gravity="center_vertical"
                        android:hint="@string/hint_task_title"
                        android:inputType="text"
                        android:paddingStart="48dp"
                        android:paddingEnd="@dimen/space_md"
                        android:textColor="@color/on_surface"
                        android:textColorHint="@color/outline"
                        android:textSize="@dimen/text_body_md" />

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_gravity="start|center_vertical"
                        android:layout_marginStart="@dimen/space_md"
                        android:contentDescription="@string/label_task_title"
                        android:src="@drawable/ic_edit"
                        app:tint="@color/outline" />
                </FrameLayout>
            </LinearLayout>

            <!-- Field 2: Description -->
            <TextView
                style="@style/Text.LabelLg"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/space_xs"
                android:fontFamily="@font/vazirmatn_bold"
                android:text="@string/label_task_desc"
                android:textColor="@color/on_surface"
                android:textStyle="bold" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/space_lg">

                <EditText
                    android:id="@+id/inputDescription"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_input"
                    android:fontFamily="@font/vazirmatn_regular"
                    android:gravity="top|start"
                    android:hint="@string/hint_task_desc"
                    android:inputType="textMultiLine"
                    android:minHeight="112dp"
                    android:paddingStart="48dp"
                    android:paddingTop="@dimen/space_md"
                    android:paddingEnd="@dimen/space_md"
                    android:paddingBottom="@dimen/space_md"
                    android:textColor="@color/on_surface"
                    android:textColorHint="@color/outline"
                    android:textSize="@dimen/text_body_md" />

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="start|top"
                    android:layout_marginStart="@dimen/space_md"
                    android:layout_marginTop="@dimen/space_md"
                    android:contentDescription="@string/label_task_desc"
                    android:src="@drawable/ic_description"
                    app:tint="@color/outline" />
            </FrameLayout>

            <!-- Field 3: Deadline -->
            <TextView
                style="@style/Text.LabelLg"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/space_xs"
                android:fontFamily="@font/vazirmatn_bold"
                android:text="@string/label_task_deadline"
                android:textColor="@color/on_surface"
                android:textStyle="bold" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/space_lg">

                <LinearLayout
                    android:id="@+id/deadlineField"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:background="@drawable/bg_input"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="48dp"
                    android:paddingEnd="@dimen/space_md">

                    <TextView
                        android:id="@+id/deadlineText"
                        style="@style/Text.BodyMd"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/label_task_deadline"
                        android:textColor="@color/on_surface"
                        android:textColorHint="@color/outline" />
                </LinearLayout>

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="start|center_vertical"
                    android:layout_marginStart="@dimen/space_md"
                    android:contentDescription="@string/label_task_deadline"
                    android:src="@drawable/ic_calendar_month"
                    app:tint="@color/outline" />
            </FrameLayout>

            <!-- Field 4: Assign to -->
            <TextView
                style="@style/Text.LabelLg"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/space_xs"
                android:fontFamily="@font/vazirmatn_bold"
                android:text="@string/label_task_assignee"
                android:textColor="@color/on_surface"
                android:textStyle="bold" />

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/space_sm"
                android:hint="@string/label_task_assignee"
                app:startIconDrawable="@drawable/ic_person"
                app:startIconTint="@color/outline">

                <AutoCompleteTextView
                    android:id="@+id/dropdownAssignee"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/vazirmatn_regular"
                    android:inputType="none"
                    android:textColor="@color/on_surface"
                    android:textSize="@dimen/text_body_md" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Priority selector (decorative) -->
            <TextView
                style="@style/Text.LabelLg"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_md"
                android:layout_marginBottom="@dimen/space_sm"
                android:fontFamily="@font/vazirmatn_bold"
                android:text="@string/label_priority"
                android:textColor="@color/on_surface"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/prioUrgent"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_marginEnd="@dimen/space_sm"
                    android:layout_weight="1"
                    android:background="@drawable/bg_chip_priority_unselected"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <View
                        android:id="@+id/dotUrgent"
                        android:layout_width="8dp"
                        android:layout_height="8dp"
                        android:layout_marginEnd="6dp"
                        android:background="@drawable/dot_status" />

                    <TextView
                        android:id="@+id/textUrgent"
                        style="@style/Text.BodySm"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/priority_urgent"
                        android:textColor="@color/on_surface_variant" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/prioNormal"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_marginEnd="@dimen/space_sm"
                    android:layout_weight="1"
                    android:background="@drawable/bg_chip_priority_selected"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <View
                        android:id="@+id/dotNormal"
                        android:layout_width="8dp"
                        android:layout_height="8dp"
                        android:layout_marginEnd="6dp"
                        android:background="@drawable/dot_status" />

                    <TextView
                        android:id="@+id/textNormal"
                        style="@style/Text.BodySm"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/priority_normal"
                        android:textColor="@color/on_primary" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/prioLow"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_chip_priority_unselected"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <View
                        android:id="@+id/dotLow"
                        android:layout_width="8dp"
                        android:layout_height="8dp"
                        android:layout_marginEnd="6dp"
                        android:background="@drawable/dot_status" />

                    <TextView
                        android:id="@+id/textLow"
                        style="@style/Text.BodySm"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/priority_low"
                        android:textColor="@color/on_surface_variant" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- Action buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_lg"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSubmit"
                style="@style/Widget.App.Button.Primary"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_marginEnd="@dimen/space_md"
                android:layout_weight="1.4"
                android:text="@string/add_task"
                app:icon="@drawable/ic_done_all"
                app:iconGravity="textStart" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCancel"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:text="@string/cancel_and_back"
                android:textColor="@color/on_surface_variant"
                app:backgroundTint="@color/surface_container_highest" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
