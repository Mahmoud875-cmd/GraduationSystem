<?xml version="1.0" encoding="utf-8"?>
<!-- A single team member row inside the student dashboard team card. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/space_sm"
    android:background="@drawable/bg_input"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="@dimen/space_sm">

    <TextView
        android:id="@+id/memberAvatar"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginEnd="@dimen/space_sm"
        android:background="@drawable/bg_circle_primary"
        android:fontFamily="@font/vazirmatn_bold"
        android:gravity="center"
        android:textColor="@color/on_primary"
        android:textSize="@dimen/text_label_md"
        tools:text="ع‌م" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/memberName"
            style="@style/Text.LabelLg"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/vazirmatn_bold"
            tools:text="علی محمدی" />

        <TextView
            android:id="@+id/memberRole"
            style="@style/Text.LabelMd"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            tools:text="سرگروه" />
    </LinearLayout>

    <TextView
        android:id="@+id/memberTag"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/chip_role_neutral"
        android:fontFamily="@font/vazirmatn_medium"
        android:paddingHorizontal="8dp"
        android:paddingVertical="2dp"
        android:text="@string/role_student"
        android:textColor="@color/on_surface_variant"
        android:textSize="@dimen/text_label_sm" />
</LinearLayout>
