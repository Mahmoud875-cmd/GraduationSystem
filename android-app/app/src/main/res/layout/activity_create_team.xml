<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/gutter"
        android:paddingVertical="@dimen/space_lg">

        <!-- Toolbar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/btnBack"
                android:layout_width="@dimen/min_touch"
                android:layout_height="@dimen/min_touch"
                android:contentDescription="@string/back"
                android:padding="12dp"
                android:src="@drawable/ic_arrow_back"
                app:tint="@color/on_surface_variant" />

            <TextView
                style="@style/Text.HeadlineSm"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_xs"
                android:text="@string/create_team_title" />
        </LinearLayout>

        <!-- Title row + group_add icon -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_md"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                style="@style/Text.HeadlineMd"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/create_new_team" />

            <FrameLayout
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_circle_secondary_container">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:contentDescription="@string/create_new_team"
                    android:src="@drawable/ic_group_add"
                    app:tint="@color/on_secondary_container" />
            </FrameLayout>
        </LinearLayout>

        <TextView
            style="@style/Text.BodyMuted"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xs"
            android:text="@string/empty_no_team_body" />

        <!-- Form card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_lg"
            android:background="@drawable/bg_card"
            android:elevation="2dp"
            android:orientation="vertical"
            android:padding="@dimen/space_lg">

            <!-- Team name -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/space_xs"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_marginEnd="@dimen/space_xs"
                    android:contentDescription="@string/label_team_name"
                    android:src="@drawable/ic_badge"
                    app:tint="@color/primary" />

                <TextView
                    style="@style/Text.LabelLg"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/label_team_name" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/space_lg"
                android:background="@drawable/bg_input"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="@dimen/space_sm">

                <EditText
                    android:id="@+id/inputTeamName"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@null"
                    android:fontFamily="@font/vazirmatn_regular"
                    android:hint="@string/hint_team_name"
                    android:inputType="text"
                    android:minHeight="@dimen/min_touch"
                    android:paddingHorizontal="@dimen/space_sm"
                    android:textColor="@color/on_surface"
                    android:textColorHint="@color/outline"
                    android:textSize="@dimen/text_body_md" />

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginEnd="@dimen/space_sm"
                    android:contentDescription="@string/label_team_name"
                    android:src="@drawable/ic_edit"
                    app:tint="@color/outline" />
            </LinearLayout>

            <!-- Member emails -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/space_xs"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_marginEnd="@dimen/space_xs"
                    android:contentDescription="@string/label_member_emails_optional"
                    android:src="@drawable/ic_mail"
                    app:tint="@color/primary" />

                <TextView
                    style="@style/Text.LabelLg"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/label_member_emails_optional" />
            </LinearLayout>

            <EditText
                android:id="@+id/inputMemberEmails"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_input"
                android:fontFamily="@font/vazirmatn_regular"
                android:gravity="top|start"
                android:hint="@string/hint_member_emails"
                android:inputType="textEmailAddress|textMultiLine"
                android:minHeight="96dp"
                android:padding="@dimen/space_md"
                android:textColor="@color/on_surface"
                android:textColorHint="@color/outline"
                android:textSize="@dimen/text_body_md" />

            <TextView
                style="@style/Text.BodyMuted"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs"
                android:text="@string/members_help"
                android:textSize="@dimen/text_body_sm" />

            <!-- "Ready for takeoff" banner -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_lg"
                android:background="@drawable/bg_banner_secondary"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="@dimen/space_md">

                <FrameLayout
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginEnd="@dimen/space_md"
                    android:background="@drawable/bg_circle_primary_container">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_gravity="center"
                        android:contentDescription="@string/team_ready_title"
                        android:src="@drawable/ic_rocket_launch"
                        app:tint="@color/on_primary_container" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/Text.LabelLg"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/team_ready_title" />

                    <TextView
                        style="@style/Text.BodyMuted"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/team_ready_body"
                        android:textSize="@dimen/text_body_sm" />
                </LinearLayout>
            </LinearLayout>

            <!-- Submit -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSubmit"
                style="@style/Widget.App.Button.Primary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_lg"
                android:text="@string/create_new_team"
                app:icon="@drawable/ic_check"
                app:iconGravity="textStart" />

            <!-- Secondary back button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCancel"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm"
                android:text="@string/back_to_dashboard"
                android:textColor="@color/on_surface_variant" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
