<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/gutter"
        android:paddingVertical="@dimen/space_lg">

        <!-- Header: back + title + step chip -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/btnBack"
                android:layout_width="@dimen/min_touch"
                android:layout_height="@dimen/min_touch"
                android:contentDescription="@string/back"
                android:padding="12dp"
                android:src="@drawable/ic_arrow_forward"
                app:tint="@color/on_surface_variant" />

            <TextView
                style="@style/Text.HeadlineSm"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_xs"
                android:layout_weight="1"
                android:text="@string/upload_report" />

            <TextView
                android:id="@+id/stepChip"
                style="@style/Text.LabelSm"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/chip_status_modern"
                android:paddingHorizontal="@dimen/space_sm"
                android:paddingVertical="4dp"
                android:text="@string/upload_step_chip"
                android:textColor="@color/on_primary_fixed" />
        </LinearLayout>

        <!-- Form card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_lg"
            android:background="@drawable/bg_card"
            android:elevation="2dp"
            android:orientation="vertical"
            android:padding="@dimen/space_lg">

            <!-- Linked task (optional) -->
            <TextView
                style="@style/Text.LabelMd"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/space_xs"
                android:text="@string/optional_link_task" />

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/select_task_linked">

                <AutoCompleteTextView
                    android:id="@+id/dropdownTask"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/vazirmatn_regular"
                    android:inputType="none"
                    android:textColor="@color/on_surface"
                    android:textSize="@dimen/text_body_md" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- File picker label -->
            <TextView
                style="@style/Text.LabelMd"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_lg"
                android:layout_marginBottom="@dimen/space_xs"
                android:text="@string/pick_file_label" />

            <!-- Dropzone -->
            <LinearLayout
                android:id="@+id/fileField"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_dropzone"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingHorizontal="@dimen/space_lg"
                android:paddingVertical="@dimen/space_xl">

                <FrameLayout
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:background="@drawable/bg_circle_cloud">

                    <ImageView
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:layout_gravity="center"
                        android:contentDescription="@string/browse_from_device"
                        android:src="@drawable/ic_cloud_upload"
                        app:tint="@color/primary_container" />
                </FrameLayout>

                <TextView
                    style="@style/Text.BodyMd"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_md"
                    android:text="@string/drop_here"
                    android:textStyle="bold" />

                <TextView
                    style="@style/Text.BodySm"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:gravity="center"
                    android:text="@string/drop_or_browse"
                    android:textColor="@color/on_surface_variant" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnBrowse"
                    style="@style/Widget.App.Button.Secondary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_md"
                    android:text="@string/browse_from_device" />
            </LinearLayout>

            <!-- Selected file info chip -->
            <LinearLayout
                android:id="@+id/fileInfoRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm"
                android:background="@drawable/bg_file_info_chip"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="@dimen/space_sm"
                android:visibility="gone">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginEnd="@dimen/space_sm"
                    android:contentDescription="@string/pick_file"
                    android:src="@drawable/ic_description"
                    app:tint="@color/primary_container" />

                <TextView
                    android:id="@+id/fileNameText"
                    style="@style/Text.BodySm"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="middle"
                    android:singleLine="true"
                    android:textColor="@color/on_surface" />

                <ImageView
                    android:id="@+id/btnRemoveFile"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:contentDescription="@string/cancel"
                    android:padding="6dp"
                    android:src="@drawable/ic_close"
                    app:tint="@color/error" />
            </LinearLayout>

            <!-- Supplementary description (cosmetic) -->
            <TextView
                style="@style/Text.LabelMd"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_lg"
                android:layout_marginBottom="@dimen/space_xs"
                android:text="@string/supplementary_desc" />

            <EditText
                android:id="@+id/inputDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_input"
                android:fontFamily="@font/vazirmatn_regular"
                android:gravity="top|start"
                android:hint="@string/hint_report_desc"
                android:importantForAutofill="no"
                android:inputType="textMultiLine"
                android:minHeight="112dp"
                android:padding="@dimen/space_md"
                android:textColor="@color/on_surface"
                android:textColorHint="@color/outline"
                android:textSize="@dimen/text_body_md" />

            <!-- Actions -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_lg"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSubmit"
                    style="@style/Widget.App.Button.Primary"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/upload_report"
                    app:icon="@drawable/ic_upload"
                    app:iconGravity="textStart" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCancel"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_sm"
                    android:text="@string/cancel"
                    android:textColor="@color/on_surface_variant" />
            </LinearLayout>
        </LinearLayout>

        <!-- Important note banner -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_lg"
            android:background="@drawable/bg_info_banner_soft"
            android:gravity="top"
            android:orientation="horizontal"
            android:padding="@dimen/space_md">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_marginTop="2dp"
                android:layout_marginEnd="@dimen/space_sm"
                android:contentDescription="@string/upload_note_title"
                android:src="@drawable/ic_info"
                app:tint="@color/on_secondary_fixed_variant" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    style="@style/Text.LabelMd"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/upload_note_title"
                    android:textColor="@color/on_secondary_fixed"
                    android:textStyle="bold" />

                <TextView
                    style="@style/Text.BodySm"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:lineSpacingMultiplier="1.3"
                    android:text="@string/upload_note_body"
                    android:textColor="@color/on_secondary_fixed_variant" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
