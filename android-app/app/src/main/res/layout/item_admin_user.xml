<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/space_md"
    android:background="@drawable/bg_stat_card"
    android:elevation="2dp"
    android:orientation="vertical"
    android:padding="@dimen/space_md">

    <!-- Top row: avatar + name/email + role chip -->
    <LinearLayout
        android:id="@+id/cardRoot"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/selectableItemBackground"
        android:baselineAligned="false"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/avatarInitials"
            style="@style/Text.HeadlineSm"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginEnd="@dimen/space_md"
            android:background="@drawable/bg_circle_avatar_secondary"
            android:fontFamily="@font/vazirmatn_bold"
            android:gravity="center"
            android:textColor="@color/on_secondary_container" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/userName"
                style="@style/Text.HeadlineSm"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="-" />

            <TextView
                android:id="@+id/userEmail"
                style="@style/Text.BodySm"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="start"
                android:textColor="@color/on_surface_variant" />
        </LinearLayout>

        <TextView
            android:id="@+id/roleChip"
            style="@style/Text.LabelSm"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_sm"
            android:background="@drawable/bg_role_chip"
            android:paddingHorizontal="@dimen/space_sm"
            android:paddingVertical="4dp"
            android:textColor="@color/on_surface"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Bottom row: ID + actions -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_md"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginEnd="6dp"
            android:contentDescription="@string/user_id_fmt"
            android:src="@drawable/ic_badge"
            app:tint="@color/on_surface_variant" />

        <TextView
            android:id="@+id/userIdText"
            style="@style/Text.BodySm"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/on_surface_variant" />

        <ImageView
            android:id="@+id/btnEditUser"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="@string/edit_user_title"
            android:padding="8dp"
            android:src="@drawable/ic_edit"
            app:tint="@color/primary" />

        <ImageView
            android:id="@+id/btnDeleteUser"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="@dimen/space_xs"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="@string/delete"
            android:padding="8dp"
            android:src="@drawable/ic_delete"
            app:tint="@color/error" />
    </LinearLayout>
</LinearLayout>
