<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/space_md"
    android:background="@drawable/bg_modern_card"
    android:elevation="1dp"
    android:orientation="vertical"
    android:padding="@dimen/space_lg">

    <!-- Row 1: type chip + date (start) ... status pill (end) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="false"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/typeChip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/chip_type_task"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="10dp"
            android:paddingVertical="5dp">

            <ImageView
                android:id="@+id/typeChipIcon"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_marginEnd="4dp"
                android:contentDescription="@string/report_type_task"
                android:src="@drawable/ic_task_alt"
                app:tint="@color/indigo_700" />

            <TextView
                android:id="@+id/typeChipText"
                style="@style/Text.LabelSm"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/report_type_task"
                android:textColor="@color/indigo_700"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/reportDate"
            style="@style/Text.LabelSm"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_sm"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/on_surface_variant" />

        <LinearLayout
            android:id="@+id/statusPill"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/chip_status_modern"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="10dp"
            android:paddingVertical="5dp">

            <View
                android:id="@+id/statusDot"
                android:layout_width="6dp"
                android:layout_height="6dp"
                android:layout_marginEnd="5dp"
                android:background="@drawable/dot_status" />

            <TextView
                android:id="@+id/statusText"
                style="@style/Text.LabelSm"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/status_approved"
                android:textColor="@color/emerald_700"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- Row 2: title (file name stands in; API has no separate title/description) -->
    <TextView
        android:id="@+id/reportTitle"
        style="@style/Text.BodyLg"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_sm"
        android:fontFamily="@font/vazirmatn_bold"
        android:text="-"
        android:textColor="@color/on_surface"
        android:textStyle="bold" />

    <!-- Attachment box -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_md"
        android:background="@drawable/bg_attachment_box"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="@dimen/space_md">

        <FrameLayout
            android:id="@+id/fileTypeTile"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginEnd="@dimen/space_md"
            android:background="@drawable/bg_file_tile">

            <ImageView
                android:id="@+id/fileTypeIcon"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:contentDescription="@string/project_reports_title"
                android:src="@drawable/ic_picture_as_pdf"
                app:tint="@color/red_600" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/reportFileName"
                style="@style/Text.BodySm"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="middle"
                android:fontFamily="@font/vazirmatn_bold"
                android:singleLine="true"
                android:text="-"
                android:textColor="@color/on_surface"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/reportFileSubtitle"
                style="@style/Text.LabelSm"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="@color/on_surface_variant" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/btnDownload"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_sm"
            android:background="@drawable/bg_download_btn"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp"
            android:paddingVertical="8dp">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginEnd="6dp"
                android:contentDescription="@string/download"
                android:src="@drawable/ic_download"
                app:tint="@color/primary" />

            <TextView
                style="@style/Text.LabelSm"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/download"
                android:textColor="@color/primary"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- Supervisor review panel (when feedback exists) -->
    <LinearLayout
        android:id="@+id/reviewPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_md"
        android:background="@drawable/bg_review_panel"
        android:orientation="vertical"
        android:padding="14dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:baselineAligned="false"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/supervisorAvatar"
                style="@style/Text.BodySm"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_marginEnd="@dimen/space_sm"
                android:background="@drawable/bg_circle_primary_container"
                android:fontFamily="@font/vazirmatn_bold"
                android:gravity="center"
                android:text="م"
                android:textColor="@color/on_primary"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/supervisorName"
                        style="@style/Text.BodySm"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/vazirmatn_bold"
                        android:textColor="@color/on_surface"
                        android:textStyle="bold" />

                    <ImageView
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:layout_marginStart="4dp"
                        android:contentDescription="@string/status_approved"
                        android:src="@drawable/ic_verified"
                        app:tint="@color/primary" />
                </LinearLayout>

                <TextView
                    style="@style/Text.LabelSm"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/supervisor_role_label"
                    android:textColor="@color/indigo_700" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/reportFeedback"
            style="@style/Text.BodySm"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_sm"
            android:background="@drawable/bg_file_box"
            android:lineSpacingMultiplier="1.25"
            android:padding="@dimen/space_sm"
            android:textColor="@color/on_surface" />

        <!-- Reply input (professor only) -->
        <LinearLayout
            android:id="@+id/commentRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_sm"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/inputComment"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/space_sm"
                android:layout_weight="1"
                android:background="@drawable/bg_download_btn"
                android:fontFamily="@font/vazirmatn_regular"
                android:hint="@string/hint_reply_supervisor"
                android:inputType="textMultiLine"
                android:maxLines="3"
                android:minHeight="40dp"
                android:paddingHorizontal="12dp"
                android:paddingVertical="8dp"
                android:textColor="@color/on_surface"
                android:textColorHint="@color/on_surface_variant"
                android:textSize="@dimen/text_body_sm" />

            <ImageView
                android:id="@+id/btnFeedback"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/bg_button_primary_container"
                android:contentDescription="@string/save_feedback"
                android:padding="8dp"
                android:rotation="180"
                android:src="@drawable/ic_send"
                app:tint="@color/on_primary" />
        </LinearLayout>
    </LinearLayout>

    <!-- Pending banner (no feedback yet) -->
    <LinearLayout
        android:id="@+id/pendingBanner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_md"
        android:background="@drawable/bg_pending_banner"
        android:baselineAligned="false"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="12dp">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginEnd="10dp"
            android:contentDescription="@string/status_pending_review"
            android:src="@drawable/ic_hourglass_top"
            app:tint="@color/amber_600" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                style="@style/Text.BodySm"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/vazirmatn_bold"
                android:text="@string/pending_note_title"
                android:textColor="@color/amber_800"
                android:textStyle="bold" />

            <TextView
                style="@style/Text.LabelSm"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/pending_note_body"
                android:textColor="@color/amber_700" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
