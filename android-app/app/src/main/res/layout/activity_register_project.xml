<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/gutter"
        android:paddingVertical="@dimen/space_lg">

        <!-- Toolbar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/btnBack"
                android:layout_width="@dimen/min_touch"
                android:layout_height="@dimen/min_touch"
                android:contentDescription="@string/back"
                android:padding="12dp"
                android:src="@drawable/ic_arrow_back"
                app:tint="@color/on_surface_variant" />

            <TextView
                style="@style/Text.HeadlineSm"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_xs"
                android:text="@string/register_project_title" />
        </LinearLayout>

        <!-- Step label + title + subtitle -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_sm"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_marginEnd="@dimen/space_xs"
                    android:contentDescription="@string/regproj_step_label"
                    android:src="@drawable/ic_school"
                    app:tint="@color/primary" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/vazirmatn_medium"
                    android:text="@string/regproj_step_label"
                    android:textColor="@color/primary"
                    android:textSize="@dimen/text_label_md" />
            </LinearLayout>

            <TextView
                style="@style/Text.HeadlineMd"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs"
                android:text="@string/register_project_title" />

            <TextView
                style="@style/Text.BodyMuted"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs"
                android:text="@string/regproj_subtitle" />
        </LinearLayout>

        <!-- Progress flow indicator card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_md"
            android:background="@drawable/bg_input"
            android:orientation="vertical"
            android:padding="@dimen/space_md">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="@font/vazirmatn_bold"
                    android:text="@string/regproj_progress_title"
                    android:textColor="@color/on_surface"
                    android:textSize="@dimen/text_label_md" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/vazirmatn_bold"
                    android:text="@string/regproj_progress_percent"
                    android:textColor="@color/primary"
                    android:textSize="@dimen/text_label_sm" />
            </LinearLayout>

            <ProgressBar
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="8dp"
                android:layout_marginTop="@dimen/space_sm"
                android:max="100"
                android:progress="35"
                android:progressDrawable="@drawable/progress_fill" />
        </LinearLayout>

        <!-- Main form card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_md"
            android:background="@drawable/bg_card"
            android:elevation="2dp"
            android:orientation="vertical"
            android:padding="@dimen/space_lg">

            <!-- Field 1: Project title -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/space_xs"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginEnd="@dimen/space_xs"
                    android:contentDescription="@string/label_project_title"
                    android:src="@drawable/ic_title"
                    app:tint="@color/primary" />

                <TextView
                    style="@style/Text.LabelLg"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/label_project_title" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="2dp"
                    android:fontFamily="@font/vazirmatn_bold"
                    android:text="@string/req_mark"
                    android:textColor="@color/error"
                    android:textSize="@dimen/text_label_lg" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_input"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="@dimen/space_sm">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginStart="@dimen/space_sm"
                    android:layout_marginEnd="@dimen/space_xs"
                    android:contentDescription="@string/label_project_title"
                    android:src="@drawable/ic_auto_stories"
                    app:tint="@color/outline_variant" />

                <EditText
                    android:id="@+id/inputTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@null"
                    android:fontFamily="@font/vazirmatn_regular"
                    android:hint="@string/hint_project_title_long"
                    android:inputType="text"
                    android:minHeight="@dimen/min_touch"
                    android:paddingHorizontal="@dimen/space_xs"
                    android:textColor="@color/on_surface"
                    android:textColorHint="@color/outline"
                    android:textSize="@dimen/text_body_md" />
            </LinearLayout>

            <TextView
                style="@style/Text.BodyMuted"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs"
                android:text="@string/title_hint"
                android:textSize="@dimen/text_body_sm" />

            <!-- Field 2: Description -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_lg"
                android:layout_marginBottom="@dimen/space_xs"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginEnd="@dimen/space_xs"
                    android:contentDescription="@string/label_description_short"
                    android:src="@drawable/ic_description"
                    app:tint="@color/primary" />

                <TextView
                    style="@style/Text.LabelLg"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/label_description_short" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/vazirmatn_medium"
                    android:text="@string/req_mark"
                    android:textColor="@color/error"
                    android:textSize="@dimen/text_label_lg" />

                <TextView
                    android:id="@+id/charCounter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_sm"
                    android:fontFamily="@font/vazirmatn_medium"
                    android:textColor="@color/outline"
                    android:textSize="@dimen/text_label_sm"
                    tools:text="۰ / ۵۰۰ نویسه" />
            </LinearLayout>

            <EditText
                android:id="@+id/inputDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_input"
                android:fontFamily="@font/vazirmatn_regular"
                android:gravity="top|start"
                android:hint="@string/desc_hint"
                android:inputType="textMultiLine"
                android:maxLength="500"
                android:minHeight="120dp"
                android:padding="@dimen/space_md"
                android:textColor="@color/on_surface"
                android:textColorHint="@color/outline"
                android:textSize="@dimen/text_body_md" />

            <TextView
                style="@style/Text.BodyMuted"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs"
                android:text="@string/desc_min_hint"
                android:textSize="@dimen/text_body_sm" />

            <!-- Field 3: Supervisor dropdown -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_lg"
                android:layout_marginBottom="@dimen/space_xs"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginEnd="@dimen/space_xs"
                    android:contentDescription="@string/label_supervisor_requested"
                    android:src="@drawable/ic_person_search"
                    app:tint="@color/primary" />

                <TextView
                    style="@style/Text.LabelLg"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/label_supervisor_requested" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="2dp"
                    android:fontFamily="@font/vazirmatn_bold"
                    android:text="@string/req_mark"
                    android:textColor="@color/error"
                    android:textSize="@dimen/text_label_lg" />
            </LinearLayout>

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/choose_supervisor"
                app:startIconDrawable="@drawable/ic_supervisor_account"
                app:startIconTint="@color/outline_variant">

                <AutoCompleteTextView
                    android:id="@+id/dropdownSupervisor"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/vazirmatn_regular"
                    android:inputType="none"
                    android:textColor="@color/on_surface"
                    android:textSize="@dimen/text_body_md" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                style="@style/Text.BodyMuted"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs"
                android:text="@string/supervisor_hint"
                android:textSize="@dimen/text_body_sm" />

            <!-- Info callout banner -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_lg"
                android:background="@drawable/bg_banner_secondary"
                android:gravity="top"
                android:orientation="horizontal"
                android:padding="@dimen/space_md">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_marginEnd="@dimen/space_sm"
                    android:contentDescription="@string/followup_title"
                    android:src="@drawable/ic_info"
                    app:tint="@color/primary" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/vazirmatn_bold"
                        android:text="@string/followup_title"
                        android:textColor="@color/on_secondary_fixed"
                        android:textSize="@dimen/text_label_md" />

                    <TextView
                        style="@style/Text.BodyMuted"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/followup_body"
                        android:textColor="@color/on_secondary_container"
                        android:textSize="@dimen/text_body_sm" />
                </LinearLayout>
            </LinearLayout>

            <!-- Quick checklist helper -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_md"
                android:background="@drawable/bg_input"
                android:orientation="vertical"
                android:padding="@dimen/space_md">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_marginEnd="@dimen/space_xs"
                        android:contentDescription="@string/checklist_title"
                        android:src="@drawable/ic_verified"
                        app:tint="@color/primary" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/vazirmatn_medium"
                        android:text="@string/checklist_title"
                        android:textColor="@color/on_surface"
                        android:textSize="@dimen/text_label_md" />
                </LinearLayout>

                <TextView
                    style="@style/Text.BodyMuted"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_xs"
                    android:text="@string/checklist_item1"
                    android:textSize="@dimen/text_body_sm" />

                <TextView
                    style="@style/Text.BodyMuted"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/checklist_item2"
                    android:textSize="@dimen/text_body_sm" />
            </LinearLayout>
        </LinearLayout>

        <!-- Action buttons -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSubmit"
            style="@style/Widget.App.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_lg"
            android:text="@string/submit_topic"
            app:icon="@drawable/ic_send"
            app:iconGravity="textStart" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCancel"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_sm"
            android:text="@string/cancel_and_return"
            app:icon="@drawable/ic_close"
            app:iconGravity="textStart" />
    </LinearLayout>
</ScrollView>
