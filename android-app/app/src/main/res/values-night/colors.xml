    <!-- Primary (lighter container + dark ink so primary_container buttons stay readable) -->
    <color name="primary">#C3C0FF</color>
    <color name="on_primary">#2514A6</color>
    <color name="primary_container">#4F46E5</color>
    <color name="on_primary_container">#E2DFFF</color>
